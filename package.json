{
    "name": "canvas-toolkit",
    "version": "0.1.0",
    "description": "A lightweight, framework-independent TypeScript UI toolkit for HTML Canvas.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "dev": "vite examples/basic"
    },
    "keywords": [
        "canvas",
        "typescript",
        "ui",
        "widgets",
        "toolkit"
    ],
    "license": "MIT",
    "sideEffects": false,
    "devDependencies": {
        "jsdom": "^30.0.1",
        "typescript": "^5.9.3",
        "vitest": "^3.2.7"
    }
}
